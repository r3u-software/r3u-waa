# Copy to .env and fill in real values from the Supabase dashboard
# (Project Settings -> API). The anon/publishable key is safe to ship in the
# client by design — Row Level Security is the real authorization gate.
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-publishable-key>
